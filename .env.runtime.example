# Public runtime origins (not secrets)
LOTBI_SITE_ORIGIN=https://lotbiai.com
LOTBI_ACCOUNT_ORIGIN=https://account.lotbiai.com

# Server-only HTTPS origin for LOTBI Core. Do not expose via frontend JavaScript.
LOTBI_CORE_BASE_URL=

# Server-only 32-byte AES-GCM key encoded as base64url.
# Used to encrypt the host-only HttpOnly LOTBI site session envelope after a future auth handoff.
LOTBI_SITE_SESSION_KEY=
