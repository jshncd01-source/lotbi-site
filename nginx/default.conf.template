server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    location = /.well-known/apple-app-site-association {
        default_type application/json;
        try_files $uri =404;
    }

    # Universal/App Link requests keep their original URL and query while the
    # root document loads the existing mobile-entry.js bridge fallback.
    location = /app/open {
        try_files /index.html =404;
    }

    # iOS Social Auth returns through this HTTPS address, then the sealed page
    # hands only an IOS_-bound, PKCE-protected result to AuthenticationServices.
    location = /app/open/auth/social-return {
        try_files /app/open/auth/social-return/index.html =404;
    }

    location ^~ /app/open/ {
        try_files /index.html =404;
    }

    # Public legal and information pages use extensionless canonical URLs.
    # Keep historical .html references durable while preserving query strings.
    location ~ ^/(about|subscribe|refund|exchange|dispute|account-deletion|contact|terms|privacy)\.html$ {
        return 301 /$1$is_args$args;
    }

    location ~ ^/(?<clean_page>about|subscribe|refund|exchange|dispute|account-deletion|contact|terms|privacy)$ {
        try_files /$clean_page.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
