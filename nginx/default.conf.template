# AUTH-SESSION-CONTINUITY-P0-02 — every HTML document names its scripts with
# the release asset token (?v=aset-…), so a stale document runs stale code.
# With no Cache-Control header, browsers kept documents by heuristic and reused
# them on tab restore and Back without asking the server: a phone could go on
# running the pre-fix /auth/callback/ long after the fix shipped. Documents
# now revalidate on every load (the ETag makes that a 304) and the login
# callback/start pages are never stored. Versioned assets are unchanged.
map $uri $lotbi_document_cache_control {
    default "";
    ~^/auth/(callback|start)(/|/index\.html)?$ "no-store";
    ~^/app/open/auth/social-return(/|/index\.html)?$ "no-store";
    ~^/(about|subscribe|refund|exchange|dispute|account-deletion|contact|terms|privacy)$ "no-cache";
    ~(^/|\.html)$ "no-cache";
    /site-asset-version.json "no-cache";
}

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;

    # An empty value (every non-document asset) sends no header at all.
    add_header Cache-Control $lotbi_document_cache_control;

    # The stock mime.types has no .mjs entry, so the Avatar runtime ES modules
    # were served as application/octet-stream and browsers refused to run them.
    # A types block here replaces the inherited http-level map, so re-include
    # the stock list first and only add what it lacks (.wasm is already there).
    include /etc/nginx/mime.types;
    types {
        application/javascript mjs;
    }

    location = /.well-known/apple-app-site-association {
        default_type application/json;
        try_files $uri =404;
    }

    # Universal/App Link requests keep their original URL and query while the
    # root document loads the existing mobile-entry.js bridge fallback.
    location = /app/open {
        try_files /index.html =404;
    }

    # iOS Social Auth returns through this HTTPS address, then the sealed page
    # hands only an IOS_-bound, PKCE-protected result to AuthenticationServices.
    location = /app/open/auth/social-return {
        try_files /app/open/auth/social-return/index.html =404;
    }

    location ^~ /app/open/ {
        try_files /index.html =404;
    }

    # Public legal and information pages use extensionless canonical URLs.
    # Keep historical .html references durable while preserving query strings.
    location ~ ^/(about|subscribe|refund|exchange|dispute|account-deletion|contact|terms|privacy)\.html$ {
        return 301 /$1$is_args$args;
    }

    location ~ ^/(?<clean_page>about|subscribe|refund|exchange|dispute|account-deletion|contact|terms|privacy)$ {
        try_files /$clean_page.html =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
